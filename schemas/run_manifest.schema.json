{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_sha256": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "minLength": 1
    },
    "episode_seed": {
      "type": "integer"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1
    },
    "cache_policy_sha256": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "smoke",
        "P1",
        "P2",
        "P3"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "previous_stage_passed": {
      "type": "boolean"
    },
    "protocol_frozen": {
      "type": "boolean"
    },
    "event_count": {
      "type": "number",
      "minimum": 0
    },
    "p50_prompt_tokens": {
      "type": "number",
      "minimum": 0
    },
    "p50_completion_tokens": {
      "type": "number",
      "minimum": 0
    },
    "retry_rate": {
      "type": "number",
      "minimum": 0
    },
    "failure_reserve": {
      "type": "number",
      "minimum": 0
    },
    "approved_token_budget": {
      "type": "number",
      "minimum": 0
    },
    "dataset_manifest": {
      "type": "string"
    },
    "checkpoint": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "cache_policy": {
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "dataset_manifest_sha256",
    "source_commit",
    "checkpoint_sha256",
    "model",
    "model_version",
    "config_sha256",
    "episode_seed",
    "max_steps",
    "cache_policy_sha256",
    "stage",
    "command",
    "previous_stage_passed",
    "protocol_frozen",
    "event_count",
    "p50_prompt_tokens",
    "p50_completion_tokens",
    "retry_rate",
    "failure_reserve",
    "approved_token_budget",
    "dataset_manifest",
    "checkpoint",
    "config",
    "cache_policy"
  ]
}